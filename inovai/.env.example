# Öffentliche Adresse des Servers (für Links in SMS/E-Mails und Webhooks)
INOVAI_BASE_URL=https://app.inovai.de
PORT=3000

# Super-Admin-Token für das Dashboard (alle Kunden). Lang & zufällig wählen!
INOVAI_ADMIN_TOKEN=bitte-mit-openssl-rand-hex-32-erzeugen

# Claude (KI). Ohne Key laufen alle Tools im Vorlagen-/Regel-Modus weiter.
ANTHROPIC_API_KEY=
# Optional anderes Modell, z. B. claude-sonnet-5-5 oder claude-haiku-5-5 (günstiger)
# INOVAI_MODEL=claude-opus-5-5

# 1 = keine echten SMS/E-Mails, nur Protokoll (zum Testen beim Kunden)
INOVAI_DRY_RUN=0

# Beispiel-Geheimnisse, auf die Kundenkonfigurationen mit "env:NAME" verweisen
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMTP_USER=
SMTP_PASS=
