# Copy to mirofish-lab/.env (gitignored, chmod 600). NEVER commit real values. Leave blank for paper mode.
#
# ---- mode gates (BOTH required for live, plus `mode: live` in config.yaml) ----
TRADING_MODE=paper
I_UNDERSTAND_REAL_MONEY=no
#
# ---- Polymarket wallet (DEDICATED hot wallet, funded only with the risk budget) ----
# 0x-prefixed private key of the signing EOA
POLY_PRIVATE_KEY=
# address that holds the USDC/positions (proxy/safe address shown on polymarket.com, or the EOA itself)
POLY_FUNDER_ADDRESS=
# 0 = EOA, 1 = POLY_PROXY (email/Magic login), 2 = POLY_GNOSIS_SAFE (browser-wallet login)
POLY_SIGNATURE_TYPE=
#
# ---- CLOB L2 API credentials (optional: derived from the key on first start if left blank) ----
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
#
# ---- optional alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
